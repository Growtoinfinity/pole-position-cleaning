{
  "functions": {
    "api/pricing.ts": { "maxDuration": 30 },
    "api/submission.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/abandonment", "schedule": "*/15 * * * *" }
  ]
}
