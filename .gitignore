*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/

.vercel

# Secrets. `.env*` only catches names that START with .env, so `local.env`,
# `prod.env` and friends slipped through - hence the second pattern.
.env*
*.env
!.env.example

# One lockfile only. Vercel builds this project with yarn, so yarn.lock is the one
# that decides the deployed dependency tree; a package-lock alongside it drifts silently.
package-lock.json
