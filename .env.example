# Copy to .env.local and fill in. Server-side only — never prefix with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase → Project Settings → API>
GHL_LOCATION_ID=g33Zu2XHv885wDNtYvZC
GHL_PIT_TOKEN=<GHL private integration token with contacts.readonly + contacts.write>

# v3 bot pricing API. Leave PRICING_API_KEY empty to keep the local price book in
# charge — every pricing path falls back cleanly when it is unset.
#
# Ask for a READ-scoped, labelled key:  --scope read --label webform
# A read key cannot write anything anywhere, which is all the calculator needs. A quote
# key would also work, but its sibling route can write prices onto any contact — do not
# hold capability you do not use. Labelled means it can be rotated without coordinating
# with the other consumers of this API.
#
# The API sends no CORS headers, deliberately: server-side only, never VITE_-prefixed,
# never in the repo, never in anything the browser downloads.
PRICING_API_KEY=<read-scoped key, labelled "webform", from the v3 bot operator>
# Override only for staging. Defaults to https://v3-bot-production-5b9f.up.railway.app
PRICING_API_URL=

# Abandonment sweep. CRON_SECRET is required — the route sends real messages, so it
# refuses every request when unset. Vercel Cron supplies it as a bearer token.
CRON_SECRET=<any long random string; set the same value in Vercel>
ABANDONMENT_IDLE_MINUTES=30
ABANDONMENT_MAX_AGE_DAYS=7

# Optional. Holds back any row whose API price is known to differ from the live
# site's and has not been signed off (see PARITY_UNRESOLVED in src/lib/price-table.ts).
# That list is currently empty, so this does nothing until a row is added to it.
# Set to `all` to release every held row.
PRICING_PARITY_APPROVED=

# Prefilled quote links (POST /api/prefill). Server-to-server only: it creates CRM
# contacts and mints URLs that carry a live quote, so it refuses every request when
# unset rather than defaulting to open. Callers send Authorization: Bearer <this>.
PREFILL_API_KEY=<any long random string; set the same value in Vercel>

# The origin the prefilled links point at. Without it the link names whichever
# deployment answered the call, which on a protected preview URL cannot even be opened.
PUBLIC_BASE_URL=https://instant-quote.greenmasterservices.co.uk
