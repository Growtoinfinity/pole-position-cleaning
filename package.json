{
  "name": "greenmaster-quote-form",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint .",
    "check:pricing": "esbuild scripts/pricing-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pricing-check.mjs --log-level=error && node node_modules/.cache/pricing-check.mjs",
    "check:functions": "node scripts/function-check.mjs",
    "preview": "vite preview",
    "check:ghl": "esbuild scripts/ghl-config-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ghl-config-check.mjs --log-level=error && node node_modules/.cache/ghl-config-check.mjs",
    "backfill:ghl": "esbuild scripts/ghl-backfill.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ghl-backfill.mjs --log-level=error --packages=external && node node_modules/.cache/ghl-backfill.mjs",
    "check:api": "tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.13",
    "@vercel/functions": "^3.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vercel/node": "^5.8.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "esbuild": "0.25.10",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
